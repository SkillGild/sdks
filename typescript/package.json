{
  "name": "@skillgild/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript client for SkillGild, the marketplace for hosted AI agent skills. Search the catalog, run hosted skills and drive hybrid tool sessions from Node.js, Bun, Deno or the browser.",
  "keywords": ["skillgild", "agent-skills", "ai-agents", "claude-skills", "claude-code", "codex", "cursor", "mcp", "llm", "sdk", "api-client"],
  "homepage": "https://skillgild.dev/docs/api?utm_source=npm&utm_medium=referral&utm_campaign=sdk",
  "repository": { "type": "git", "url": "git+https://github.com/SkillGild/sdks.git", "directory": "typescript" },
  "bugs": { "url": "https://github.com/SkillGild/sdks/issues" },
  "author": "SkillGild (https://skillgild.dev)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "provenance": true },
  "devDependencies": { "typescript": "^5.7.0" }
}
